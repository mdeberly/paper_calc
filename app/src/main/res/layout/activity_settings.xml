<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include layout="@layout/top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- History -->
            <TextView style="@style/SectionTitle" android:text="@string/history" />

            <TextView
                android:id="@+id/btn_history"
                style="@style/RowButton"
                android:text="@string/history_open" />

            <!-- Decimal separator -->
            <TextView style="@style/SectionTitle" android:text="@string/decimal_separator" />

            <RadioGroup
                android:id="@+id/rg_decimal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/rb_dec_comma" style="@style/Option" android:text="@string/sep_comma" />
                <RadioButton android:id="@+id/rb_dec_point" style="@style/Option" android:text="@string/sep_point" />
            </RadioGroup>

            <!-- Thousands separator -->
            <TextView style="@style/SectionTitle" android:text="@string/thousands_separator" />

            <RadioGroup
                android:id="@+id/rg_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/rb_grp_point" style="@style/Option" android:text="@string/sep_point" />
                <RadioButton android:id="@+id/rb_grp_comma" style="@style/Option" android:text="@string/sep_comma" />
                <RadioButton android:id="@+id/rb_grp_space" style="@style/Option" android:text="@string/sep_space" />
            </RadioGroup>

            <TextView
                android:id="@+id/tv_example"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink"
                android:textSize="17sp" />

            <!-- Copy button behaviour -->
            <TextView style="@style/SectionTitle" android:text="@string/copy_mode" />

            <RadioGroup
                android:id="@+id/rg_copy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton android:id="@+id/rb_copy_full" style="@style/Option" android:text="@string/copy_full" />
                <RadioButton android:id="@+id/rb_copy_result" style="@style/Option" android:text="@string/copy_result_only" />
            </RadioGroup>

            <!-- Haptic feedback -->
            <TextView style="@style/SectionTitle" android:text="@string/feedback" />

            <CheckBox
                android:id="@+id/cb_haptic"
                style="@style/Option"
                android:text="@string/haptic_feedback" />

            <!-- Language -->
            <TextView style="@style/SectionTitle" android:text="@string/language" />

            <TextView
                android:id="@+id/btn_language"
                style="@style/RowButton" />

            <!-- About -->
            <TextView style="@style/SectionTitle" android:text="@string/about" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/outline_bg"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_about"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="3dp"
                        android:contentDescription="@string/flag_france"
                        android:src="@drawable/flag_fr" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_ai"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/btn_latest_release"
                    style="@style/RowButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/check_latest_release" />

                <TextView
                    android:id="@+id/tv_release_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
